@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.PublicAPI.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@title</h3>

<EditForm EditContext="@editContext" OnValidSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- AmountID (editable) -->
    <div class="form-group row" style="margin-top:20px">
        <label for="AmountID" class="col-sm-2 col-form-label">
            Amount ID
        </label>
        <div class="col-sm-10">
            <InputNumber id="AmountID" class="form-control" @bind-Value="Amount.AmountID" />
            <ValidationMessage For="@(() => Amount.AmountID)" />
        </div>
    </div>

    <!-- AmountTitle -->
    <div class="form-group row">
        <label for="title" class="col-sm-2 col-form-label">
            Title
        </label>
        <div class="col-sm-10">
            <InputText id="title" class="form-control" placeholder="Title" @bind-Value="Amount.AmountTitle" />
            <ValidationMessage For="@(() => Amount.AmountTitle)" />
        </div>
    </div>

    <!-- NutrientsID -->
    <div class="form-group row" style="margin-top:20px">
        <label for="nutrientsId" class="col-sm-2 col-form-label">
            Nutrients ID
        </label>
        <div class="col-sm-10">
            <InputNumber id="nutrientsId" class="form-control" @bind-Value="Amount.NutrientsID" />
            <ValidationMessage For="@(() => Amount.NutrientsID)" />
        </div>
    </div>

    <!-- AmountDate -->
    <div class="form-group row" style="margin-top:20px">
        <label for="amountDate" class="col-sm-2 col-form-label">
            Date
        </label>
        <div class="col-sm-10">
            <InputDate id="amountDate" class="form-control" @bind-Value="Amount.AmountDate" />
            <ValidationMessage For="@(() => Amount.AmountDate)" />
        </div>
    </div>

    <!-- Submit button -->
    <div class="form-group row" style="margin-top:20px">
        <label for="submit" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary" id="submit">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private Amount Amount = new Amount();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private string title = "Edit";

    protected override async Task OnInitializedAsync()
    {
        Amount = new Amount();  // Kindel algus
        editContext = new EditContext(Amount);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            Amount.AmountDate = DateTime.Today;
            return;
        }

        var result = await apiClient.Get(Id);

        if (!result.HasError && result.Value != null)
        {
            Amount = result.Value;
            editContext = new EditContext(Amount);
            messageStore = new ValidationMessageStore(editContext);
        }
        else
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(Amount);

        if (!result.HasError)
        {
            NavManager.NavigateTo("/");
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                // Lisa veateade vormi üldise veana (pole seotud konkreetse väljaga)
                messageStore?.Add(new FieldIdentifier(Amount, string.Empty), result.ErrorMessage);
            }

            // Teavita EditForm'i, et vead on muutunud
            editContext?.NotifyValidationStateChanged();
        }
    }
}
