@page "/"

<PageTitle>Amount</PageTitle>

<h1>Amount</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (Amount == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><a class="btn btn-primary" href="/create">Add new</a></p>
    <table class="table">
        <thead>
            <tr>
                <th>Amount ID</th>
                <th>Title</th>
                <th>Nutrients ID</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Amount in Amount)
            {
                <tr>
                    <td>@Amount.AmountID</td>
                    <td>@Amount.AmountTitle</td>
                    <td>@Amount.NutrientsID</td>
                    <td>@Amount.AmountDate.ToShortDateString()</td>
                    <td>
                        <a href="/edit/@Amount.AmountID" class="btn btn-primary">Edit</a>
                        <button class="btn btn-primary" @onclick="() => Delete(Amount.AmountID)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}